{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/R0bes/aip/blob/main/report.schema.json",
  "title": "AIP run report v0.3 draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "header",
    "blocks"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.3.0"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "$ref": "#/$defs/github"
          },
          {
            "$ref": "#/$defs/artifact"
          },
          {
            "$ref": "#/$defs/notice"
          }
        ]
      }
    },
    "next_run": {
      "$ref": "run-ui.schema.json"
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "operation",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "github"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "changes",
            "branch",
            "commit",
            "pull_request",
            "comparison",
            "other"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string"
        },
        "expected_behavior": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "kind",
        "content"
      ],
      "properties": {
        "type": {
          "const": "artifact"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "command",
            "agent_prompt",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "text"
      ],
      "properties": {
        "type": {
          "const": "notice"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        }
      }
    }
  }
}
